# docker compose용 환경변수 — 복사해서 .env.docker로 저장하고 값 채우기
# (셋 다 같은 파일을 쓰므로 JWT_SECRET이 자동으로 공유됨 — 쿠키 SSO의 핵심)

# 중앙 DB (mysql 서비스 컨테이너)
DATABASE_URL=mysql://root:change-me@mysql:3306/admin_dashboard
MYSQL_ROOT_PASSWORD=change-me

# 세 앱이 같은 값이어야 로그인 쿠키가 공유된다
JWT_SECRET=

# 테넌트 식별
TENANT_BASE_DOMAIN=
DEFAULT_CHURCH_SLUG=

# Google OAuth (web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=
OWNER_OPEN_ID=

# AI 어시스턴트 (web, 선택)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# S3 (web, 선택 — 없으면 로컬 uploads 볼륨 사용)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# 프록시 노출 포트
HTTP_PORT=80

# 교인 개인정보 컬럼 암호화 키 (members 앱) — 세 앱 공유 파일이므로 여기 포함
MEMBER_DATA_KEY=

# 기부금영수증 주민번호 암호화 키 (finance 앱)
FINANCE_DATA_KEY=

# 다교회 운영 시 reject 권장 — 교회 미식별 요청이 중앙 DB로 폴백하는 것을 차단
TENANT_FALLBACK=reject
